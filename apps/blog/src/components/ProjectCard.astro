---
import type { Project } from '../data/projects'
import ProjectPop from './ProjectPop.astro'

type Props = { project: Project }

const { project } = Astro.props
const Tag = project.url ? 'a' : 'div'
---

<Tag
	href={project.url}
	target={project.url ? '_blank' : undefined}
	rel={project.url ? 'noopener' : undefined}
	class:list={[
		'project group relative flex h-[152px] flex-col justify-end gap-0.5 rounded-[20px] border border-line bg-card p-5',
		project.url && 'transition-colors hover:border-line-strong focus-visible:border-faint focus-visible:outline-none',
	]}
>
	<ProjectPop pop={project.pop} name={project.name} />
	<h3 class="flex items-center gap-1.5 text-base leading-[26px] font-medium text-ink">
		{project.name}
		{
			project.url && (
				<svg
					viewBox="0 0 12 12"
					width="12"
					height="12"
					aria-hidden="true"
					class="size-3 -translate-x-1 text-faint opacity-0 transition duration-200 group-hover:translate-x-0 group-hover:opacity-100"
				>
					<path d="M3.5 8.5l5-5M4.5 3.5h4v4" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			)
		}
	</h3>
	<p class="max-w-[264px] text-sm leading-[22px] text-balance text-muted">
		{project.description}
	</p>
</Tag>

<style>
	/* The object that sticks out of the card lifts on hover. */
	.project :global(.pop) {
		transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	@media (hover: hover) {
		.project:hover :global(.pop) {
			transform: translateY(-6px);
		}
	}

	.project:focus-visible :global(.pop) {
		transform: translateY(-6px);
	}

	@media (prefers-reduced-motion: reduce) {
		.project :global(.pop) {
			transition: none;
		}
		.project:hover :global(.pop),
		.project:focus-visible :global(.pop) {
			transform: none;
		}
	}
</style>
