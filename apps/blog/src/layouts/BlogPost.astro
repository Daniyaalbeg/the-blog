---
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '../lib/content'
import Site from './Site.astro'

type Neighbour = Pick<CollectionEntry<'blog'>, 'id'> & { title: string }

type Props = {
	post: CollectionEntry<'blog'>['data']
	minutes: number
	previous?: Neighbour
	next?: Neighbour
}

const { post, minutes, previous, next } = Astro.props
const { title, description, pubDate, updatedDate, heroImage } = post
---

<Site title={title} description={description} image={heroImage}>
	<article>
		<header class="flex flex-col gap-4">
			<a href="/blog/" class="self-start text-sm leading-[22px] text-faint transition-colors hover:text-ink">
				← All writing
			</a>
			<h1 class="font-serif text-[36px] leading-[44px] tracking-[-0.02em] text-balance text-ink sm:text-[44px] sm:leading-[52px]">
				{title}
			</h1>
			<p class="text-lg leading-7 text-pretty text-muted">{description}</p>
			<p class="flex flex-wrap gap-x-3 pt-2 text-sm leading-[22px] text-faint">
				<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
				<span aria-hidden="true">·</span>
				<span>{minutes} min read</span>
				{
					updatedDate && (
						<>
							<span aria-hidden="true">·</span>
							<span>
								Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
							</span>
						</>
					)
				}
			</p>
		</header>

		<div class="post prose prose-invert mt-14">
			<slot />
		</div>
	</article>

	{
		(previous || next) && (
			<nav aria-label="More writing" class="mt-20 flex flex-col gap-5 border-t border-line pt-10 sm:flex-row">
				{previous ? (
					<a
						href={`/blog/${previous.id}/`}
						class="flex flex-1 flex-col gap-1 rounded-2xl border border-line bg-card p-5 transition-colors hover:border-line-strong"
					>
						<span class="text-[13px] leading-5 text-faint">← Previous</span>
						<span class="text-base leading-[26px] font-medium text-ink">{previous.title}</span>
					</a>
				) : (
					<div class="hidden flex-1 sm:block" />
				)}
				{next ? (
					<a
						href={`/blog/${next.id}/`}
						class="flex flex-1 flex-col items-end gap-1 rounded-2xl border border-line bg-card p-5 text-right transition-colors hover:border-line-strong"
					>
						<span class="text-[13px] leading-5 text-faint">Next →</span>
						<span class="text-base leading-[26px] font-medium text-ink">{next.title}</span>
					</a>
				) : (
					<div class="hidden flex-1 sm:block" />
				)}
			</nav>
		)
	}
</Site>
