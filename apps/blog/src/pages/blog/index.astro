---
import PostList from '../../components/PostList.astro'
import Site from '../../layouts/Site.astro'
import { getPosts } from '../../lib/content'

const posts = await getPosts()
---

<Site title="Writing · Daniyaal Beg" description="Notes on animation, interfaces and the web.">
	<h1 class="font-serif text-[36px] leading-[44px] tracking-[-0.02em] text-ink">Writing</h1>
	<p class="mt-2 mb-10 text-lg leading-7 text-muted">Notes on animation, interfaces and the web.</p>
	<PostList posts={posts} />
</Site>
