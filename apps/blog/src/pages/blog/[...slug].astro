---
import { render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import BlogPost from '../../layouts/BlogPost.astro'
import { getPosts, readingMinutes } from '../../lib/content'

export async function getStaticPaths() {
	// Newest first, so "previous" is the older post and "next" the newer one.
	const posts = await getPosts()
	return posts.map((post, i) => {
		const older = posts[i + 1]
		const newer = posts[i - 1]
		return {
			params: { slug: post.id },
			props: {
				post,
				previous: older && { id: older.id, title: older.data.title },
				next: newer && { id: newer.id, title: newer.data.title },
			},
		}
	})
}

type Neighbour = { id: string; title: string }
type Props = { post: CollectionEntry<'blog'>; previous?: Neighbour; next?: Neighbour }

const { post, previous, next } = Astro.props
const { Content } = await render(post)
---

<BlogPost post={post.data} minutes={readingMinutes(post.body)} previous={previous} next={next}>
	<Content />
</BlogPost>
