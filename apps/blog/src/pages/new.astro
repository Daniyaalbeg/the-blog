---
import BaseHead from '../components/BaseHead.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts'
import { getCollection } from 'astro:content'

type Project = {
	name: string
	url: string
	description: string
	tools: string
	label: string
}

const projects: Project[] = [
	{
		name: 'Prompt Builder',
		url: 'https://github.com/Daniyaalbeg/prompt-builder',
		description:
			'An open source tool that allows you to manage and generate prompts for image generation.',
		tools: 'NextJS, Tailwind, Drizzle, Lucia, Shadcn, Planetscale',
		label: 'OSS',
	},
	{
		name: 'Ministry of Change',
		url: 'https://ministryofchange.org',
		description:
			'A web portal for a non-profit organization. React front-end with an express backend.',
		tools: 'React, Express, MongoDB, TailwindCSS, Node',
		label: 'Client',
	},
	{
		name: 'Dwordle',
		url: 'https://github.com/Daniyaalbeg/dwordle',
		description: 'A wordle clone for the cli.',
		tools: 'Node, Figlet, Chalk',
		label: 'CLI',
	},
]

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

const writingByYear = posts.reduce(
	(acc, post) => {
		const year = new Date(post.data.pubDate).getFullYear().toString()
		acc[year] ??= []
		acc[year].push(post)
		return acc
	},
	{} as Record<string, typeof posts>,
)

const updatedLabel = new Intl.DateTimeFormat('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
}).format(new Date())

const footerCopy =
	'Projects, tutorials, and experiments from this corner of the internet.'

const formatDayMonth = (date: Date) =>
	new Intl.DateTimeFormat('en-GB', {
		day: '2-digit',
		month: '2-digit',
	}).format(date)
---

<!doctype html>
<html lang="en" class="h-full max-w-7xl mx-auto">
	<head>
		<BaseHead title={`${SITE_TITLE} - New`} description={SITE_DESCRIPTION} />
	</head>
	<body class="min-h-screen bg-[#dddddd] text-[#1f1f1f]">
		<div class="mx-auto flex min-h-screen w-full max-w-7xl justify-center">
			<main class="flex min-h-screen w-full max-w-[520px] flex-col px-6 py-20 sm:px-8 sm:py-28">
			<header class="space-y-1">
				<h1 class="text-[1.04rem] font-medium text-[#333333]">{SITE_TITLE}</h1>
				<p class="text-[1.04rem] text-[#8f8f8f]">Updated {updatedLabel}</p>
			</header>

			<section class="space-y-4 pt-8 text-[1.04rem] leading-[1.6] text-[#1f1f1f]">
				<p class="text-pretty">Hi there, I am Daniyaal. A wanna be software engineer.</p>
				<p class="text-pretty">{SITE_DESCRIPTION} Welcome to my digital home.</p>
				<p class="text-pretty">
					Some projects are finished, some not so finished, some yet to start,
					but all trying to be awesome.
				</p>
				<p class="text-pretty">
					I also write distilled arcane knowledge about SVGs, animation,
					Tailwind, React, and small details of front-end craft.
				</p>
				<p class="text-pretty">
					You can find me on
					<a
						href="https://twitter.com/daniyaalbeg"
						target="_blank"
						rel="noreferrer"
						class="underline decoration-[1px] underline-offset-2"
					>
						Twitter
					</a>
					and
					<a
						href="https://github.com/daniyaalbeg"
						target="_blank"
						rel="noreferrer"
						class="underline decoration-[1px] underline-offset-2"
					>
						GitHub
					</a>
					.
				</p>
			</section>

			<section class="pt-10">
				<h2 class="text-base text-[#9a9a9a]">Selected work</h2>
				<div class="mt-2 h-px bg-[#d1d1d1]"></div>
				<ul>
					{
						projects.map((project) => (
							<li class="grid grid-cols-[4rem,1fr] gap-4 border-b border-[#d4d4d4] py-3 sm:grid-cols-[4.5rem,1fr,6rem] sm:items-start">
								<div class="pt-0.5 text-[0.98rem] text-[#8d8d8d]">{project.label}</div>
								<div>
									<a
										href={project.url}
										target="_blank"
										rel="noreferrer"
										class="text-[1.04rem] text-[#1d1d1d] underline decoration-transparent underline-offset-2 transition hover:decoration-current"
									>
										{project.name}
									</a>
									<p class="pt-1 text-[0.98rem] leading-6 text-[#5f5f5f] text-pretty">
										{project.description}
									</p>
								</div>
								<div class="hidden pt-0.5 text-right text-[0.98rem] text-[#8c8c8c] sm:block">
									{project.tools.split(',')[0]}
								</div>
							</li>
						))
					}
				</ul>
			</section>

			<section class="pt-10">
				<h2 class="text-base text-[#9a9a9a]">Writing</h2>
				<div class="mt-2 h-px bg-[#d1d1d1]"></div>
				<div>
					{Object.entries(writingByYear).map(([year, entries]) =>
						entries.map((post, index) => (
							<div class="grid grid-cols-[4rem,1fr,4rem] gap-4 border-b border-[#d4d4d4] py-2 text-[1rem] last:border-b-0 sm:grid-cols-[4.5rem,1fr,4.5rem]">
								<div class="text-[#8d8d8d]">{index === 0 ? year : ''}</div>
								<div class="flex items-center gap-2 min-w-0">
									<a
										href={`/blog/${post.id}/`}
										class="min-w-0 truncate text-[#1d1d1d] underline decoration-transparent underline-offset-2 transition hover:decoration-current"
									>
										{post.data.title}
									</a>
									{
										index === 0 && (
											<span class="rounded-full border border-[#ff2aa8] px-2 py-0.5 text-[0.84rem] leading-none text-[#ff2aa8]">
												Latest
											</span>
										)
									}
								</div>
								<div class="text-right text-[#8c8c8c]">
									{formatDayMonth(new Date(post.data.pubDate))}
								</div>
							</div>
						)),
					)}
				</div>
			</section>

			<footer class="mt-auto pt-10">
				<div class="h-px w-16 bg-[#d1d1d1]"></div>
				<p class="pt-8 text-[0.96rem] leading-6 text-[#9b9b9b] text-pretty">{footerCopy}</p>
			</footer>
			</main>
		</div>
	</body>
</html>
