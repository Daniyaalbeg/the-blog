---
import Site from '../../layouts/Site.astro'

const tools = [
	{
		href: '/tools/svg-path-splitter/',
		name: 'SVG Path Splitter',
		description: 'Break a single SVG path into its separate shapes, ready to animate.',
	},
]
---

<Site title="Tools · Daniyaal Beg" description="Small tools I built for myself.">
	<h1 class="font-serif text-[36px] leading-[44px] tracking-[-0.02em] text-ink">Tools</h1>
	<p class="mt-2 mb-10 text-lg leading-7 text-muted">Small tools I built for myself.</p>
	<ul class="-mx-4 flex flex-col gap-1">
		{
			tools.map((tool) => (
				<li>
					<a href={tool.href} class="block rounded-xl px-4 py-3 transition-colors hover:bg-card">
						<h2 class="text-base leading-[26px] font-medium text-ink">{tool.name}</h2>
						<p class="text-base leading-[26px] text-muted">{tool.description}</p>
					</a>
				</li>
			))
		}
	</ul>
</Site>
