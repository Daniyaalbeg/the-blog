---
import ShortList from '../components/ShortList.astro'
import Site from '../layouts/Site.astro'
import { getShorts } from '../lib/content'

// Dynamic only so the page isn't generated (or listed in the sitemap) until a short is published.
export async function getStaticPaths() {
	const shorts = await getShorts()
	return shorts.length > 0 ? [{ params: { shorts: 'shorts' } }] : []
}

const shorts = await getShorts()
---

<Site title="Shorts · Daniyaal Beg" description="Quick thoughts, a few lines at a time.">
	<h1 class="font-serif text-[36px] leading-[44px] tracking-[-0.02em] text-ink">Shorts</h1>
	<p class="mt-2 mb-10 text-lg leading-7 text-muted">Quick thoughts, a few lines at a time.</p>
	<ShortList shorts={shorts} />
</Site>
