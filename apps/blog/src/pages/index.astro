---
import PostList from '../components/PostList.astro'
import ProjectCard from '../components/ProjectCard.astro'
import ShortList from '../components/ShortList.astro'
import { projects } from '../data/projects'
import Site from '../layouts/Site.astro'
import { getPosts, getShorts } from '../lib/content'

const posts = await getPosts()
const shorts = await getShorts()
---

<Site nav={false}>
	<section class="max-w-[548px]">
		<h1 class="font-serif text-2xl leading-9 tracking-[-0.16px] text-ink">daniyaalbeg</h1>
		<div class="flex flex-col gap-6 text-base leading-[26px] text-pretty text-muted">
			<p>
				I'm a product-minded developer in London building focused digital experiences for the web.
			</p>
			<p>
				Most of my work sits between interface design and engineering: prototyping interactions,
				shaping systems, and refining the details that make software feel good.
			</p>
			<p>
				Elsewhere, I experiment with small tools and write about animation, interfaces, and the web.
			</p>
		</div>
	</section>

	<section id="projects" class="mt-[72px] scroll-mt-12">
		<h2 class="font-serif text-2xl leading-9 tracking-[-0.16px] text-ink">Projects</h2>
		<div class="mt-6 grid grid-cols-1 gap-x-5 gap-y-20 pt-14 sm:grid-cols-2">
			{projects.map((project) => <ProjectCard project={project} />)}
		</div>
	</section>

	{
		posts.length > 0 && (
			<section id="writing" class="mt-[72px]">
				<h2 class="mb-6 font-serif text-2xl leading-9 tracking-[-0.16px] text-ink">Writing</h2>
				<PostList posts={posts} />
			</section>
		)
	}

	{
		shorts.length > 0 && (
			<section id="shorts" class="mt-[72px] flex flex-col gap-6">
				<div class="flex items-baseline justify-between">
					<h2 class="font-serif text-2xl leading-9 tracking-[-0.16px] text-ink">Shorts</h2>
					<p class="text-sm leading-[22px] text-faint">Quick thoughts</p>
				</div>
				<ShortList shorts={shorts.slice(0, 3)} />
				<a
					href="/shorts/"
					class="self-start text-sm leading-[22px] font-medium text-muted transition-colors hover:text-ink"
				>
					All shorts →
				</a>
			</section>
		)
	}
</Site>
