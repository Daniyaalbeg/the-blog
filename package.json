{
  "name": "the-blog",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/blog dev",
    "build": "bun run --cwd apps/blog build",
    "preview": "bun run --cwd apps/blog preview",
    "check": "bun run --cwd apps/blog check"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "packageManager": "bun@1.3.5"
}
